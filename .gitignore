# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.verify/
!.env.example
test-results/
playwright-report/
graphify-out/

# Local agent / editor state. Never machine-specific config in the repo.
# .vscode/launch.json IS committed on purpose (it is the F5 entry point);
# settings.json is per-developer and is not.
.claude/settings.local.json
.vscode/settings.json
*.local

# Internal build artifacts: the AI build brief, the session handoff log and the
# planning specs. They carry personal contact details and local machine paths,
# and they describe how the site was produced rather than what it does. Kept on
# disk, out of the published repo. docs/security/ deliberately STAYS public:
# those reports are evidence of real work and the site links to them.
/internal/
