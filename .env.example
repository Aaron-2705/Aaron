# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
# Nothing here reaches the client except the NEXT_PUBLIC_ entry at the bottom.

# Contact form - Resend relay (https://resend.com)
# Without these the endpoint returns 503 NOT_CONFIGURED and the form falls back
# to opening the visitor's own mail client.
RESEND_API_KEY=
# Where transmissions land.
CONTACT_TO_EMAIL=
# Optional verified sender. Defaults to Resend's onboarding sender.
CONTACT_FROM_EMAIL=

# Optional. Set to a GitHub username to switch the field-report feed from the
# curated static log to that account's live public activity. Left unset by
# default so the site never depends on an unauthenticated third-party API.
NEXT_PUBLIC_GITHUB_USER=
# The site's public origin. Sets metadataBase, which is what makes the Open
# Graph image URL absolute. Wrong or unset and the social card will not render
# even though the file is served.
NEXT_PUBLIC_SITE_URL=
